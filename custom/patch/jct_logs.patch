+/* ==========================================================================
+ * JCT 排障调试日志
+ *
+ * 开启方式: 编译时加 -DJCT_DEBUG, 例如:
+ *   make debug CFLAGS_EXTRA=-DJCT_DEBUG      (见 Makefile)
+ *   gcc -DJCT_DEBUG ...
+ *
+ * 日志输出到 stderr (默认无缓冲), 崩溃前最后一条日志即指示崩溃所在阶段。
+ * 生产构建不定义 JCT_DEBUG 时, JCT_LOG 不产生任何代码, 零开销。
+ * ========================================================================== */
+#ifndef JCT_DEBUG
+#define JCT_DEBUG 0
+#endif
+
+#if JCT_DEBUG
+#include <stdio.h>
+#ifndef JCT_LOG
+#define JCT_LOG(...)                                                                                               \
+  do {                                                                                                             \
+    fprintf(stderr, "[JCT %s:%d %s] ", __FILE__, __LINE__, __func__);                                              \
+    fprintf(stderr, __VA_ARGS__);                                                                                  \
+    fputc('\n', stderr);                                                                                           \
+  } while (0)
+#endif
+#else
+#define JCT_LOG(...) ((void)0)
+#endif
+
 #ifdef __cplusplus
 extern "C" {
 #endif
