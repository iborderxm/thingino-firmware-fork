+/* 解析递归深度计数器 (仅 JCT_DEBUG 时使用; 非线程安全, 排障单线程足够)。
+ * 若 JSON 嵌套过深造成栈溢出, 崩溃前日志会出现持续增大的 depth 值。 */
+static int jct_parse_depth = 0;
+
+/* parse_value 调试包装器: 记录递归深度、入口字符与返回类型,
+ * parse_array/parse_object 的所有递归调用都会经过这里。 */
+static JsonValue *parse_value(JsonParser *parser) {
+  ++jct_parse_depth;
+  unsigned char peek = 0;
+  if (parser->pos < parser->len) {
+    peek = (unsigned char)parser->json[parser->pos];
+  }
+  JCT_LOG("enter depth=%d pos=%zu len=%zu peek='%c'(0x%02x)",
+          jct_parse_depth, parser->pos, parser->len,
+          (peek >= 0x20 && peek < 0x7f) ? (int)peek : '?', (unsigned)peek);
+
+  JsonValue *result = parse_value_inner(parser);
+
+  JCT_LOG("leave depth=%d result=%p type=%d", jct_parse_depth, (void *)result,
+          result ? (int)result->type : -1);
+  --jct_parse_depth;
+  return result;
+}
