+// Build an HEVCDecoderConfigurationRecord (hvcC) from VPS + SPS + PPS
+// (start-code-free NALs, 2-byte HEVC NAL header included). Same record the
+// recording path produces in MP4ControlSocket.cpp.
+std::vector<uint8_t> build_hvcC(const std::vector<uint8_t> &vps,
+                                const std::vector<uint8_t> &sps,
+                                const std::vector<uint8_t> &pps) {
+  std::vector<uint8_t> hvcC;
+  if (sps.size() < 4 || pps.empty())
+    return hvcC;
+
+  // Profile/level fields live in the SPS payload after the 2-byte NAL
+  // header: byte[3] space/tier/profile_idc, [4..7] compat flags,
+  // [8..13] constraint flags, [14] level_idc. Zero-fill what a short SPS
+  // does not carry so the record layout stays fixed-width.
+  uint8_t profile_byte = 0, level_idc = 0, num_layers = 1, nested = 0;
+  uint8_t compat[4] = {0, 0, 0, 0};
+  uint8_t constraint[6] = {0, 0, 0, 0, 0, 0};
+  if (sps.size() >= 3) {
+    num_layers = static_cast<uint8_t>(((sps[2] >> 1) & 0x07) + 1);
+    nested = sps[2] & 0x01;
+  }
+  if (sps.size() >= 4)
+    profile_byte = sps[3];
+  if (sps.size() >= 8)
+    for (int i = 0; i < 4; ++i)
+      compat[i] = sps[4 + i];
+  if (sps.size() >= 14)
+    for (int i = 0; i < 6; ++i)
+      constraint[i] = sps[8 + i];
+  if (sps.size() >= 15)
+    level_idc = sps[14];
+
+  hvcC.push_back(0x01); // configurationVersion
+  hvcC.push_back(profile_byte);
+  hvcC.insert(hvcC.end(), compat, compat + 4);
+  hvcC.insert(hvcC.end(), constraint, constraint + 6);
+  hvcC.push_back(level_idc);
+  hvcC.push_back(0xF0); // reserved(4) | min_spatial_segmentation_idc(12) = 0
+  hvcC.push_back(0x00);
+  hvcC.push_back(0xFC); // reserved(6) | parallelismType(2) = 0
+  hvcC.push_back(0xFD); // reserved(6) | chromaFormat(2) = 1 (4:2:0)
+  hvcC.push_back(0xF8); // reserved(5) | bitDepthLumaMinus8(3) = 0
+  hvcC.push_back(0xF8); // reserved(5) | bitDepthChromaMinus8(3) = 0
+  hvcC.push_back(0x00); // avgFrameRate = 0 (unspecified)
+  hvcC.push_back(0x00);
+  hvcC.push_back(static_cast<uint8_t>((0 << 6) | ((num_layers & 0x07) << 3) |
+                                      (nested << 2) | 0x03));
+
+  // NAL arrays: VPS (32), SPS (33), PPS (34); skip any that are missing.
+  struct NalEntry {
+    uint8_t type;
+    const std::vector<uint8_t> *data;
+  };
+  const NalEntry entries[3] = {{32, &vps}, {33, &sps}, {34, &pps}};
+  uint8_t num_arrays = 0;
+  for (const auto &e : entries)
+    if (!e.data->empty())
+      ++num_arrays;
+  hvcC.push_back(num_arrays);
+  for (const auto &e : entries) {
+    if (e.data->empty())
+      continue;
+    hvcC.push_back(static_cast<uint8_t>(0x80 | (e.type & 0x3F)));
+    hvcC.push_back(0x00); // numNalus = 1
+    hvcC.push_back(0x01);
+    uint16_t len = static_cast<uint16_t>(e.data->size());
+    hvcC.push_back(static_cast<uint8_t>(len >> 8));
+    hvcC.push_back(static_cast<uint8_t>(len & 0xFF));
+    hvcC.insert(hvcC.end(), e.data->begin(), e.data->end());
+  }
+  return hvcC;
+}
