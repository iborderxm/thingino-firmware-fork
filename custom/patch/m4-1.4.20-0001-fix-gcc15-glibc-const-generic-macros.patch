diff --git a/lib/stdlib.in.h b/lib/stdlib.in.h
index 1342db4..38a86d0 100644
--- a/lib/stdlib.in.h
+++ b/lib/stdlib.in.h
@@ -237,7 +237,11 @@ _GL_INLINE_HEADER_BEGIN
 
 /* Declarations for ISO C N3322.  */
 #if defined __GNUC__ && __GNUC__ >= 15 && !defined __clang__
-_GL_EXTERN_C void *bsearch (const void *__key,
+/* glibc >= 2.43 将 bsearch 定义为 _Generic 函数式宏(C23 常量保持),
+   裸函数名在此处会被宏展开成 _Generic(...) 导致语法错误;
+   写成 (bsearch) 可抑制宏展开, 等价于 gnulib 上游的
+   _GL_FUNCDECL_SYS_NAME (bsearch) 写法。 */
+_GL_EXTERN_C void *(bsearch) (const void *__key,
                             const void *__base, size_t __nmemb, size_t __size,
                             int (*__compare) (const void *, const void *))
   _GL_ATTRIBUTE_NONNULL_IF_NONZERO (2, 3) _GL_ARG_NONNULL ((5));
diff --git a/lib/string.in.h b/lib/string.in.h
index e764221..fc41d12 100644
--- a/lib/string.in.h
+++ b/lib/string.in.h
@@ -236,7 +236,10 @@ _GL_EXTERN_C int memcmp (const void *__s1, const void *__s2, size_t __n)
 _GL_EXTERN_C int strncmp (const char *__s1, const char *__s2, size_t __n)
   _GL_ATTRIBUTE_NONNULL_IF_NONZERO (1, 3)
   _GL_ATTRIBUTE_NONNULL_IF_NONZERO (2, 3);
-# ifndef __cplusplus
+/* glibc >= 2.43 已把 memchr 定义为 _Generic 函数式宏, 系统头已给出
+   可用声明; 此时跳过 gnulib 的补充声明, 避免裸函数名被宏展开
+   (对齐 gnulib 上游 string.in.h 的守卫写法)。 */
+# if !defined memchr && !defined __cplusplus
 _GL_EXTERN_C void *memchr (const void *__s, int __c, size_t __n)
   _GL_ATTRIBUTE_NONNULL_IF_NONZERO (1, 3);
 _GL_EXTERN_C void *memrchr (const void *__s, int __c, size_t __n)
diff --git a/lib/wchar.in.h b/lib/wchar.in.h
index 8836ed1..182779f 100644
--- a/lib/wchar.in.h
+++ b/lib/wchar.in.h
@@ -298,7 +298,9 @@ _GL_EXTERN_C int wcsncmp (const wchar_t *__s1, const wchar_t *__s2, size_t __n)
   _GL_ATTRIBUTE_NONNULL_IF_NONZERO (1, 3)
   _GL_ATTRIBUTE_NONNULL_IF_NONZERO (2, 3);
 # ifndef __cplusplus
-_GL_EXTERN_C wchar_t *wmemchr (const wchar_t *__s, wchar_t __wc, size_t __n)
+/* glibc >= 2.43 将 wmemchr 定义为 _Generic 函数式宏,
+   写成 (wmemchr) 抑制宏展开(对齐 gnulib 上游)。 */
+_GL_EXTERN_C wchar_t *(wmemchr) (const wchar_t *__s, wchar_t __wc, size_t __n)
   _GL_ATTRIBUTE_NONNULL_IF_NONZERO (1, 3);
 # endif
 _GL_EXTERN_C wchar_t *wmemset (wchar_t *__s, wchar_t __wc, size_t __n)
