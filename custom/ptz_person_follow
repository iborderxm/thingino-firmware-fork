#!/bin/sh
#
# PTZ 人形跟踪桩脚本（开发期验证链路用，不含真实电机驱动）
#
# 接口（与 C++ 侧约定，见设计文档 4.3.1）：
#   ptz_person_follow start  <cx> <cy>  # 开始跟踪；保存原位；启动后台控制循环
#   ptz_person_follow update <cx> <cy>  # 更新目标中心（主码流像素坐标）
#   ptz_person_follow home              # 转回原位后退出跟踪
#   ptz_person_follow status            # 输出当前状态
#
# 约定：
#   1. 即发即走：收到指令后立即返回，转动/等待到位等耗时动作放后台执行，
#      避免阻塞 PersonDetection 的检测循环；
#   2. 电机标志：转动期间 touch /run/motors-active，到位后立即删除。
#      若标志常驻，C++ 侧会在此期间持续跳过人形检测，导致 update 饥饿（风险 10）。
#
# 调试：日志写 $PTZ_LOG，状态写 $PTZ_STATE。

. /usr/share/common

MOTORS_ACTIVE=${MOTORS_ACTIVE:-/run/motors-active}
PTZ_LOG=${PTZ_LOG:-/tmp/ptz_person_follow.log}
PTZ_STATE=${PTZ_STATE:-/tmp/ptz_person_follow.state}
MOVE_SEC=${MOVE_SEC:-0.8}	# 模拟单次转动耗时(秒)

log() {
	echo "$(date '+%F %T') pid=$$ $*" >>"$PTZ_LOG" 2>/dev/null
}

# 模拟一次转动：持有电机标志 → 到位 → 释放标志（为 update 留出窗口）
simulate_move() {
	(
		touch "$MOTORS_ACTIVE" 2>/dev/null
		sleep "$MOVE_SEC"
		rm -f "$MOTORS_ACTIVE" 2>/dev/null
	) >/dev/null 2>&1 &
}

case "$1" in
start)
	# 幂等：已在跟踪则忽略，避免重复启动控制循环（风险 2）
	if [ -f "$PTZ_STATE" ] && [ "$(cut -d' ' -f1 "$PTZ_STATE" 2>/dev/null)" = "running" ]; then
		log "start ignored, already tracking"
		exit 0
	fi
	echo "running $(date +%s) ${2:--1} ${3:--1}" >"$PTZ_STATE" 2>/dev/null
	log "start cx=${2:--1} cy=${3:--1}"
	simulate_move
	;;
update)
	echo "running $(date +%s) ${2:--1} ${3:--1}" >"$PTZ_STATE" 2>/dev/null
	log "update cx=${2:--1} cy=${3:--1}"
	;;
home)
	echo "idle $(date +%s) -1 -1" >"$PTZ_STATE" 2>/dev/null
	log "home"
	simulate_move
	;;
status)
	cat "$PTZ_STATE" 2>/dev/null || echo "idle -1 -1"
	;;
*)
	log "unknown action: $1"
	exit 1
	;;
esac

exit 0
