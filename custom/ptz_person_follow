#!/bin/sh
#
# PTZ 人形跟踪控制脚本
#
# 设计依据：docs/PTZ_PERSON_FOLLOW_DESIGN.md 第 4.3 节
#
# 接口（由 PersonDetection::ptzNotify 调用，均为"即发即走"）：
#   ptz_person_follow start  <cx> <cy>  # 开始跟踪：保存当前位置为原位，并做首次修正
#   ptz_person_follow update <cx> <cy>  # 跟踪中：以当前位置为原点换算新目标坐标
#   ptz_person_follow home              # 结束跟踪：转回原位
#   ptz_person_follow status            # 调试：输出模式/位置/行程
#
# 关键约定（改动前请先读 4.3 节）：
#   1. 前台必须快速返回。motor 客户端"发一次请求、读一次状态即退出"，
#      真正的运动由 motor-daemon 在后台完成，故本脚本无需后台化子进程；
#   2. /run/motors-active 由 motor-daemon 自行创建与删除，本脚本不得 touch/rm，
#      否则会与其轮询线程竞争；异常退出改用 motors -d s 停止运动；
#   3. 每次决策都必须重新执行 motors -i 读取当前位置作为原点（已确认为实时值）；
#   4. 不下发 `-s`：移动速度交由守护进程的 `last_known_speed`（会话级）决定，
#      其初值与上限由 `/etc/motors.json` 的 `speed_pan` / `speed_tilt` 管控，本脚本不干预；
#   5. 任一依赖缺失或取值失败都必须记日志后正常返回，不得阻塞 C++ 录制主流程。

# ------------------------------------------------------------------ 可调参数
# 无独立配置文件：直接编辑此处，或通过同名环境变量覆盖（便于上机调试）

MOTORS_BIN=${MOTORS_BIN:-/bin/motors}              # 电机客户端
MOTORS_JSON=${MOTORS_JSON:-/etc/motors.json}       # 行程/速度配置
PRUDYNT_JSON=${PRUDYNT_JSON:-/etc/prudynt.json}    # prudynt配置
PARAM_JSON=${PARAM_JSON:-/tmp/motors_param.json}   # motors -i 输出快照
PTZ_STATE=${PTZ_STATE:-/tmp/ptz_person_follow.state}
PTZ_LOG=${PTZ_LOG:-/tmp/ptz_person_follow.log}
SENSOR_DIR=${SENSOR_DIR:-/proc/jz/sensor}          # 主码流分辨率来源（需与 OSD 绘制分辨率一致）

# P 控制比例系数，以百分数表示：100 即 Kp=1.0（单次转动即把人形拉到中心附近）。
# 注：Kp>=1.0 时不再"分步收敛"；若镜头 FOV 标定偏大，单次转动可能冲过中心到另一侧。
#     本设备 FOV 为估算值（85°/29°），上机实测校正后再决定是否长期用 100；临时降压可在此改回 50。
KP_X=${KP_X:-100}
KP_Y=${KP_Y:-100}
# 方向修正：上机核 direction 后若反向，把对应值改为 -1（亦可用 motors -I x / -I y）
DIR_X=${DIR_X:-1}
DIR_Y=${DIR_Y:-1}
# 视场角（度）：把"像素偏差"换算成"角度偏差"，再用行程步数表达。
# 由"镜头焦距 + 传感器尺寸"决定，与电机行程（pan 360° / tilt 90°）无关。
# 当前默认值按本设备 JX-Q03P-C1-M3（1/2.7"、2.5μm 像素）+ 主码流 3982x1100 + 2.8mm 镜头估算：
#   FOV_H = 2·atan(5.2mm / 2 / 2.8mm)              ≈ 85°
#   FOV_V = 2·atan(tan(42.5°) × 1100 / 3982)       ≈ 29°
# ⚠️ 镜头焦距未知，上机必须实测校正。估计值偏小只会导致欠修正（收敛更慢），不会发散。
# 若仅有 FOV_H，可用 FOV_V = 2·atan(tan(FOV_H/2) × HEIGHT/WIDTH) 推导（sh 无 atan，可用线性近似）。
FOV_H_DEG=${FOV_H_DEG:-85}
FOV_V_DEG=${FOV_V_DEG:-29}

# ------------------------------------------------------------------ 基础工具

log() {
	echo "$(date '+%F %T') pid=$$ $*" >>"$PTZ_LOG" 2>/dev/null
}

# Thingino 公共函数库。缺失时必须"记日志后继续"，不得让脚本中断退出 ——
# 一是遵守脚本头第 5 条约定（不得阻塞 C++ 录制主流程）：dash 下 `.` 打不开
# 绝对路径会直接以退出码 2 终止整个脚本，那样人形跟踪会静默失效；
# 二是让本脚本能在宿主机上用桩做单元测试（见 tests/scripts/test_ptz_person_follow.sh）。
if [ -r /usr/share/common ]; then
	. /usr/share/common
else
	log "WARN: /usr/share/common missing, continue without it"
fi

command_present() {
	command -v "$1" >/dev/null 2>&1
}

# 变量必须是纯数字（jct 返回的是字符串，需防御脏数据）
is_uint() {
	case "$1" in
		'' | *[!0-9]*) return 1 ;;
	esac
	return 0
}

clamp() {
	v=$1
	[ "$v" -lt "$2" ] && v=$2
	[ "$v" -gt "$3" ] && v=$3
	echo "$v"
}

# 读取 prudynt 配置中的人形语音警告开关与音频路径，并在启用时播放。
# 播放在后台进行，前台必须快速返回，不得阻塞 C++ 录制主流程（脚本头约定 #1）。
play_warn_voice() {
	if ! command_present jct; then
		log "WARN: jct not found, skip warn voice"
		return 0
	fi

	local enabled
	enabled=$(jct "$PRUDYNT_JSON" get persondetection.person_warn_enabled 2>/dev/null)
	case "$enabled" in
		true | 1) ;;
		*) return 0 ;;
	esac

	local voice
	voice=$(jct "$PRUDYNT_JSON" get persondetection.person_warn_voice 2>/dev/null)
	[ -n "$voice" ] || { log "WARN: warn voice path empty"; return 0; }
	[ -e "$voice" ] || { log "WARN: warn voice file not found: $voice"; return 0; }

	if ! command_present play; then
		log "WARN: play not found, skip warn voice"
		return 0
	fi

	log "warn voice enabled, play: $voice"
	play -l 2 -d 5000 "$voice" >/dev/null 2>&1 &
}

save_state() {
	cat >"$PTZ_STATE" 2>/dev/null <<EOF
mode=$mode
home_x=$home_x
home_y=$home_y
EOF
}

load_state() {
	mode=idle
	home_x=
	home_y=
	[ -f "$PTZ_STATE" ] || return 0

	# 只接受本脚本写入的 key=value 格式。桩脚本遗留的是空格分隔格式，
	# 直接 source 会把它当命令执行而报错，此处识别后按无状态处理。
	case "$(cat "$PTZ_STATE" 2>/dev/null)" in
		*mode=*)
			. "$PTZ_STATE"
			;;
		*)
			log "WARN: incompatible state file, treating as idle"
			mode=idle
			home_x=
			home_y=
			;;
	esac
}

# 异常中断时停止电机：-d s 会让守护进程立即移除 /run/motors-active
trap 'log "WARN: signal received, stopping motor"; "$MOTORS_BIN" -d s >/dev/null 2>&1; exit 1' INT TERM

# ------------------------------------------------------------------ 环境读取

# 读取分辨率、当前位置、行程上限；成功返回 0 并设置 WIDTH HEIGHT XPOS YPOS XMAX YMAX
read_env() {
	WIDTH=$(cat "$SENSOR_DIR/width" 2>/dev/null)
	HEIGHT=$(cat "$SENSOR_DIR/height" 2>/dev/null)
	if ! is_uint "$WIDTH" || ! is_uint "$HEIGHT"; then
		log "ERR: bad resolution '$WIDTH'x'$HEIGHT' from $SENSOR_DIR"
		return 1
	fi

	if ! command_present jct; then
		log "ERR: jct not found"
		return 1
	fi
	if ! command_present "$MOTORS_BIN"; then
		log "ERR: $MOTORS_BIN not found"
		return 1
	fi

	XMAX=$(jct "$MOTORS_JSON" get motors.steps_pan 2>/dev/null)
	YMAX=$(jct "$MOTORS_JSON" get motors.steps_tilt 2>/dev/null)
	if ! is_uint "$XMAX" || ! is_uint "$YMAX"; then
		log "ERR: bad steps '$XMAX'/'$YMAX' from $MOTORS_JSON"
		return 1
	fi

	# motors -i 为实时读取，必须每次重新执行：当前位置是换算的唯一基准
	if ! "$MOTORS_BIN" -i >"$PARAM_JSON" 2>/dev/null; then
		log "ERR: $MOTORS_BIN -i failed (motor-daemon not running?)"
		return 1
	fi
	XPOS=$(jct "$PARAM_JSON" get xpos 2>/dev/null)
	YPOS=$(jct "$PARAM_JSON" get ypos 2>/dev/null)
	if ! is_uint "$XPOS" || ! is_uint "$YPOS"; then
		log "ERR: bad position '$XPOS'/'$YPOS'"
		return 1
	fi
	return 0
}

# ------------------------------------------------------------------ 换算与控制

# 人形中心像素坐标 -> 新的电机绝对坐标（4.3.4：以当前位置为原点）
#   target = 当前位置 + (cx - W/2) * XMAX * KP / 100 / W
# 结果写入 target_x / target_y
px_to_target() {
	# cx,cy 是人形中心像素坐标
	cx=$1
	cy=$2

	# 不做死区判定：始终按偏差向画面中心修正。自然停止点由整数步数截断决定
	# ——当单次修正步数不足 1 步（本设备 pan |dx|≲8px / tilt |dy|≲25px）时
	# target 与当前位置相同，do_track 走"no move"分支，不会无限微调。
	# ⚠️ 是否真正持续下发，由 C++ 侧 kPtzToleranceRatioPctX / kPtzToleranceRatioPctY 门控决定；脚本本身不拦。
	# WIDTH 和 HEIGHT 是分辨率
	# dx_px 是人形中心像素坐标与画面中心像素坐标的横向偏差
	# dy_px 是人形中心像素坐标与画面中心像素坐标的纵向偏差
	dx_px=$((cx - WIDTH / 2))
	dy_px=$((cy - HEIGHT / 2))

	# 限幅必须在加成之后做，否则可能下发越界目标撞限位
	# 增益修正：圆周云台 pan=360° / tilt=90°，画面整宽只对应一个 FOV 视角，
	# 故步数/像素必须按 FOV/行程 缩放（否则按"整幅=整程"会高估数倍导致发散）。
	# 先 /WIDTH 再乘 KP*FOV/360/100，避免中间值溢出。
	target_x=$(clamp $((XPOS + DIR_X * dx_px * XMAX / WIDTH * KP_X * FOV_H_DEG / 360 / 100)) 0 "$XMAX")
	target_y=$(clamp $((YPOS + DIR_Y * dy_px * YMAX / HEIGHT * KP_Y * FOV_V_DEG / 90 / 100)) 0 "$YMAX")
}

# 绝对定位下发。不带 -s：速度沿用守护进程的 last_known_speed（会话级），
# 其初值与上限由 /etc/motors.json 的 speed_pan / speed_tilt 管控
move_to() {
	"$MOTORS_BIN" -d h -x "$1" -y "$2" >/dev/null 2>&1
	ret=$?
	if [ "$ret" -ne 0 ]; then
		log "WARN: move to $1,$2 failed ret=$ret"
	fi
	return $ret
}

# 依目标坐标做一次跟随
do_track() {
	if ! is_uint "$1" || ! is_uint "$2"; then
		log "WARN: skip track, bad coords '$1','$2'"
		return 0
	fi

	px_to_target "$1" "$2"

	if [ "$target_x" -eq "$XPOS" ] && [ "$target_y" -eq "$YPOS" ]; then
		log "track cx=$1 cy=$2 no move (negligible), pos=$XPOS,$YPOS"
		return 0
	fi

	log "track cx=$1 cy=$2 d=$dx_px,$dy_px pos=$XPOS,$YPOS -> $target_x,$target_y"
	move_to "$target_x" "$target_y"
}

# ------------------------------------------------------------------ 命令分发

case "$1" in
	start)
		load_state
		if [ "$mode" = "running" ]; then
			log "start ignored, already tracking"
			exit 0
		fi

		read_env || exit 0

		# 原位 = 本次跟踪开始时的位置，回位时按其恢复，无累积误差
		mode=running
		home_x=$XPOS
		home_y=$YPOS
		save_state
		log "start cx=${2:--1} cy=${3:--1} home=$home_x,$home_y res=${WIDTH}x${HEIGHT} max=$XMAX,$YMAX"

		play_warn_voice
		do_track "$2" "$3"
		;;

	update)
		load_state
		if [ "$mode" != "running" ]; then
			log "update ignored, not tracking"
			exit 0
		fi

		# 上一次移动未结束则丢弃本次 update：串行处理会堆积指令，
		# 且随后的新 update 会带上更准的坐标（下一次机会很快到来）
		if [ "$("$MOTORS_BIN" -b 2>/dev/null)" = "1" ]; then
			log "update busied, skip cx=${2:--1} cy=${3:--1}"
			exit 0
		fi

		read_env || exit 0
		do_track "$2" "$3"
		;;

	home)
		load_state

		if is_uint "$home_x" && is_uint "$home_y"; then
			log "home -> $home_x,$home_y"
			move_to "$home_x" "$home_y"
		else
			# 状态文件缺失（如崩溃后重启）：回 4.3.7 的机械 HOME 兜底
			log "WARN: no saved home, fallback to -d b (mechanical HOME)"
			"$MOTORS_BIN" -d b >/dev/null 2>&1
		fi

		mode=idle
		home_x=
		home_y=
		save_state
		rm -f "$PARAM_JSON"
		;;

	status)
		load_state
		echo "mode=${mode}"
		echo "home=${home_x:--1},${home_y:--1}"
		if read_env; then
			echo "pos=$XPOS,$YPOS"
			echo "res=${WIDTH}x${HEIGHT}"
			echo "max=$XMAX,$YMAX"
		else
			echo "pos=unavailable"
		fi
		;;

	*)
		log "unknown action: $1"
		exit 1
		;;
esac

exit 0
